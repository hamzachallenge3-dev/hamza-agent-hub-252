{
  "name": "hamza-agent-hub",
  "version": "1.2.1",
  "description": "One MCP plugin for Cursor + ChatGPT/Codex store: Desk + ECC68 + Forge + Tools13 + browse + FreeLLMAPI",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --experimental-sqlite dist/index.js",
    "test": "node --experimental-sqlite --import tsx node_modules/vitest/vitest.mjs run",
    "pack:chatgpt": "bash ./scripts/pack-chatgpt-plugin.sh",
    "dev": "HAH_TRANSPORT=stdio npx tsx --experimental-sqlite src/index.ts",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "check": "npm run build && npm test && npm run test:python && python3 packs/tools13/scripts/verify_bundle.py && npm run pack:chatgpt",
    "benchmark": "npx tsx scripts/benchmark.ts",
    "audit:agents": "npx tsx scripts/agent-audit.ts",
    "smoke:browser": "npx tsx scripts/browser-smoke.ts",
    "smoke:console": "npx tsx scripts/console-check.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "bin": {
    "hamza-agent-hub": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "playwright": "^1.64.1"
  }
}
