{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hamza-agent-hub-edge-lab",
  "main": "worker.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "observability": {"enabled": false},
  "unsafe": {"bindings": [{"name": "RATE_LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": {"limit": 120, "period": 60}}]},
  "vars": {"ALLOWED_ORIGINS": "https://chatgpt.com"}
}
