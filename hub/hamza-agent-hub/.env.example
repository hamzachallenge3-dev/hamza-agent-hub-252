HAH_TRANSPORT=stdio
HAH_CONCURRENCY=2
HAH_DATA_DIR=./data
HAH_WORKSPACES_DIR=./workspaces
HAH_DB_PATH=./data/hamza-hub.sqlite

# --- FreeLLMAPI (open-source free LLM gateway) ---
# https://github.com/tashfeenahmed/freellmapi
# Alias: HAH_MODEL_PROVIDER=lotf also selects FreeLLMAPI
HAH_MODEL_PROVIDER=freellmapi
HAH_USE_FREELLMAPI=1
HAH_FREELLMAPI_URL=http://127.0.0.1:3001/v1
HAH_FREELLMAPI_MODEL=auto
HAH_FREELLMAPI_KEY=
# Mirrored for generic OpenAI-compatible clients:
HAH_MODEL_URL=http://127.0.0.1:3001/v1
HAH_MODEL_NAME=auto
HAH_MODEL_API_KEY=

HAH_GLM_LAB_URL=
HAH_HEADROOM_LAB_URL=
HAH_AUTH_TOKEN=
HAH_HOST=127.0.0.1
HAH_PORT=8790
HAH_DESK_URL=https://desk.imdifferent01.com

# Sandbox shell (authenticated HTTP / HUB_SECRET path only; not on stdio)
# HAH_ENABLE_SANDBOX_TOOLS=1
# HUB_SANDBOX_USER=agentbox
# HUB_SANDBOX_WORK_DIR=/home/agentbox/work
# HAH_ORIGIN_PORT=8787

# ChatGPT Plugin Directory domain verification token (plain text at /.well-known/openai-apps-challenge)
HAH_OPENAI_APPS_CHALLENGE=

# Runtime safety limits
HAH_MAX_ATTEMPTS=3
HAH_RATE_LIMIT=120
HAH_TASK_TIMEOUT_MS=120000
# Probe only the local free gateway if no model endpoint is explicitly configured.
HAH_AUTO_FREELLMAPI=1
HAH_MAX_PENDING=1000
